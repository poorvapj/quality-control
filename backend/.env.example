# Copy to .env for local dev. On Render, set these as real environment variables instead.

# MongoDB Atlas connection string (the database this board reads/writes).
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
# Database name to use on that cluster.
MONGODB_DB=tower_quality_board

# Cloudinary — used to store snag/QC evidence photos, uploaded under ProjectQuality/<type>
# in your existing Cloudinary account (never touches other folders, e.g. your VMS assets).
# Paste the single "API Environment variable" string from the Cloudinary dashboard.
# This is the ONLY Cloudinary credential the server reads — there is no separate
# cloud_name/api_key/api_secret fallback by design.
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# The exact origin your frontend is served from (e.g. https://your-app.vercel.app).
# Leave unset ("*") only while testing — lock it down before going live.
ALLOWED_ORIGIN=*

# Secret key used to sign login session JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Keep this secret — anyone with it can forge an admin session. The server
# refuses to start if this is missing.
JWT_SECRET=

# Render sets PORT automatically; only needed for local overrides.
# PORT=5173

# --- n8n / Slack drawing-request approvals (optional) ---------------------

# n8n Webhook-trigger URL. If set, the server POSTs a small JSON payload here
# every time a drawing request's reviewStatus really changes (new stage,
# approved, returned) — whether that change came from the app UI or from the
# automation endpoint below. Leave unset to disable entirely.
N8N_WEBHOOK_URL=

# Shared secret n8n must send back as the X-Automation-Secret header when
# calling POST /api/automation/drawing-requests/:id/decision (e.g. after a
# Slack "Approve"/"Return" button click). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Leave unset to disable that endpoint (it 501s with no secret configured).
AUTOMATION_SECRET=
