# Copy to .env for local dev. On Render, set these as real environment variables instead.

# MongoDB Atlas connection string (the database this board reads/writes).
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
# Database name to use on that cluster.
MONGODB_DB=tower_quality_board

# Cloudinary — used to store snag/QC evidence photos, uploaded under ProjectQuality/<type>
# in your existing Cloudinary account (never touches other folders, e.g. your VMS assets).
# Paste the single "API Environment variable" string from the Cloudinary dashboard.
# This is the ONLY Cloudinary credential the server reads — there is no separate
# cloud_name/api_key/api_secret fallback by design.
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# The exact origin your frontend is served from (e.g. https://your-app.vercel.app).
# Leave unset ("*") only while testing — lock it down before going live.
ALLOWED_ORIGIN=*

# Secret key used to sign login session JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Keep this secret — anyone with it can forge an admin session. The server
# refuses to start if this is missing.
JWT_SECRET=

# Render sets PORT automatically; only needed for local overrides.
# PORT=5173

# --- Slack notifications, direct (optional, no n8n needed) -----------------

# Bot token from a Slack app (api.slack.com/apps -> your app -> OAuth &
# Permissions -> Bot User OAuth Token, starts with xoxb-). Needs scopes
# chat:write and users:read.email. If set, the server DMs the relevant
# person directly (matched to Slack by their account email) on:
# drawing request approved/returned, work assigned/reassigned, snag
# assigned/reassigned, snag reopened.
SLACK_BOT_TOKEN=

# Channel ID (not name) to also post every one of those events into, so the
# whole team can see who has what pending. Right-click the channel in
# Slack -> View channel details -> copy the ID at the bottom (starts with
# C). The bot must be invited to this channel (/invite @YourBotName) or
# posts to it will silently fail. Leave unset to only send DMs, no channel
# copy.
SLACK_CHANNEL_ID=

# --- n8n / Slack notifications via n8n (optional, alternative to the above) -

# n8n Webhook-trigger URL. If set, the server POSTs a small JSON payload here
# ({eventType, ...}) for every one of these real events:
#   drawing_request_stage_change  - reviewStatus really changes (new stage,
#                                    approved, returned) — from the app UI or
#                                    from the automation endpoint below
#   work_assigned                 - a unit/floor stage is assigned or
#                                    reassigned to someone
#   snag_assigned                 - a snag is raised with, or reassigned to,
#                                    someone
#   snag_reopened                 - a Closed snag is reopened
# Each payload includes the relevant person's email (assignedToEmail /
# requesterEmail) so an n8n workflow can match them to a Slack user for a DM,
# and/or post the same event into a shared "team updates" Slack channel —
# that routing/formatting lives in n8n, not here. Leave unset to disable
# entirely (every notify call becomes a no-op).
N8N_WEBHOOK_URL=

# Shared secret n8n must send back as the X-Automation-Secret header when
# calling POST /api/automation/drawing-requests/:id/decision (e.g. after a
# Slack "Approve"/"Return" button click). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Leave unset to disable that endpoint (it 501s with no secret configured).
AUTOMATION_SECRET=
